type: mech
name: Mabuz
description: Fires alternating clusters of bullets. Cannot cross terrain.
research: efhover-fabricator
researchCost: [
  efscrap/80
  efalluminum/60
] 
researchCostMultiplier: 0.1
moveSound: loopExtract
moveSoundVolume: 0.25
moveSoundPitchMin: 0.5
moveSoundPitchMax: 1
hovering: true
hoverable: true
shadowElevation: 0.1
mechFrontSway: 0
mechSideSway: 0
mechStride: 0
drag: 0.1
outlineColor: 13151AFF
speed: 2.66666666666666666666666666666666666666666666
rotateSpeed: 5
accel: 0.1
groundLayer: 60
health: 300
armor: 1
hitSize: 8
canDrown: false
itemCapacity: 10
fogRadius: 12
range: 75


abilities: [
  {
    type: MoveEffectAbility
    teamColor: true
    effect: missileTrailShort
    x: 0
    y: -4
    interval: 2
    minVelocity: 0.2
  }
]


engines: [
  {
    x: 0
    y: -3.5
    radius: 1
  }
]


useEngineElevation: false
lowAltitude: true


weapons: [
  {
    shootCone: 30
    inaccuracy: 7
    velocityRnd: 0.2
    x: 2
    y: 3
    name: mabuz-weapon
    mirror: true
    alternate: true
    top: false
    reload: 40
    rotate: false
    shootSound: shootElude
    recoil: 0.5
    shoot: {
      shots: 2
      shotDelay: 2
    }
    bullet: { 
      type: BasicBulletType
      width: 6
      height: 12
      damage: 15
      lifetime: 20
      speed: 6
      smokeEffect: shootSmokeSquare
      trailColor: E6D837
      trailWidth: 1
      trailLength: 7
      trailParam: 1.6
      hitColor: F7EE8AFF
      backColor: E6D837
      frontColor: F7EE8AFF
      collidesTeam: false
      hitSound: none
      despawnSound: none
      homingPower: 0.013
      hitEffect: {
        type: ExplosionEffect
        lifetime: 20
        waveStroke: 1
        waveColor: F7EE8AFF
        sparkColor: F7EE8AFF
        waveRad: 2
        smokeSize: 0
        smokeSizeBase: 0
        sparks: 3
        sparkRad: 12
        sparkLen: 1
        sparkStroke: 1
      }
    }
  }
]
