type: HeaterGenerator
name: Thermal Reactor
description: Produces a greater amount of power from a thermal reaction. Outputs excess heat for later uses in crafting, etc. 
size: 4
category: power
squareSprite: false
hasPower: true
hasLiquids: true
hasItems: true


requirements: [
  efscrap/280
  efcopper/220
  efalluminum/140
  efcupride/60
]


powerProduction: 12
consumes: {
  items: [
    efsoft-coal/1
  ]
  liquids: [
	efslag/0.2
	efpurified-water/0.15
	efneutralizer/0.15
  ] 
}


itemDuration: 120
ambientSound: loopSmelter
ambientSoundVolume: 0.05


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidRegion
	  suffix: -liquid1
      drawLiquid: efslag
      alpha: 1
      padding: 2
    }
    {
      type: DrawBubbles
      fill: false
	  spread: 10
	  color: FFCD66FF
    }
    {
	  type: DrawCrucibleFlame
	  flameRad: 3
	  particleRad: 14
	  flameRadiusScl: 12
	  flameRadiusMag: 1
	  circleSpace: 1
	}
    {    
      type: DrawDefault
    }
    {
      type: DrawHeatOutput
    }
  ]
}


heatOutput: 8
sideHeat: [1]


research: {
	parent: ignition-plant
	objectives: [
	    efpurified-water
    ] 
} 
researchCost: [
	efscrap/1400
    efcopper/1100
    efalluminum/700
    efcupride/300
]










