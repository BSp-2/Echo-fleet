type: ConsumeGenerator
name: LPG Engine
description: Utilizes liquid petroleum gas in a combustion reaction to generate extensive amounts of power. Will output fluctuating power most of the time. Suggested to use with battaries. 
size: 5
category: power
squareSprite: false


requirements: [
  efscrap/600
  efcopper/540
  efalluminum/360
  efcupride/300
]


consumes: {
  liquids: [
 	eflpg/0.8
	efneutralizer/0.15
  ]
}


powerProduction: 240
ambientSound: loopSmelter
ambientSoundVolume: 0.03
hasLiquids: true
hasPower: true


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: eflpg
      alpha: 1
      padding: 3
    } 
    {
      type: DrawPlasma
	  plasmas: 4
	  plasma1: FF6A00FF
	  plasma2: FF6A00FF
	  plasma3: FF6A00FF
	  plasma4: FF6A00FF
    }
    {
      type: DrawDefault
    }
    {
	  type: DrawGlowRegion
	  alpha: 1
	  glowIntensity: 0.6
	  color: FF6A00FF
	  suffix: -glow
	  glowScale: 12
	}
  ]
}


research: {
	parent: efthermal-reactor
	objectives: [
		eflpg
      {
        type: OnSector
        preset: apparition
      }
	]
} 
researchCost: [
	efscrap/1200
	efcopper/1100
	efalluminum/800
	efcupride/650
]
	
