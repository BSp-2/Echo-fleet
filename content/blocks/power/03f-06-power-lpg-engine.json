type: ConsumeGenerator
name: LPG Engine
description: Utilizes liquid petroleum gas in a combustion reaction to generate extensive amounts of power. Will output fluctuating power most of the time. Suggested to use with battaries. 
size: 5
category: power
squareSprite: false


requirements: [
  01a-01-item-scrap/600
  01a-02-item-copper/540
  01a-04-item-alluminum/360
  01a-05-item-cupride/300
]


consumes: {
  liquids: [
 	02a-05-liquid-lpg/0.8
	 02a-12-liquid-neutralizer/0.15
  ]
}


powerProduction: 240
ambientSound: loopSmelter
ambientSoundVolume: 0.03
hasLiquids: true
hasPower: true


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: 02a-05-liquid-lpg
      alpha: 1
      padding: 3
    } 
    {
      type: DrawPlasma
	  plasmas: 4
	  plasma1: FF6A00FF
	  plasma2: FF6A00FF
	  plasma3: FF6A00FF
	  plasma4: FF6A00FF
    }
    {
      type: DrawDefault
    }
    {
	  type: DrawGlowRegion
	  alpha: 1
	  glowIntensity: 0.6
	  color: FF6A00FF
	  suffix: -glow
	  glowScale: 12
	}
  ]
}


research: {
	parent: 03f-05-power-thermal-chamber
	objectives: [
		02a-05-liquid-lpg
	]
} 
ResearchCost: [
	01a-01-item-scrap/1200
	01a-02-item-copper/1100
	01a-04-item-alluminum/800
	01a-05-item-cupride/650
]
	
