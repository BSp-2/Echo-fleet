type: ConsumeGenerator
name: Decay Cell
description: Outputs mediocre amounts of power by collecting heat from ozone decaying into oxygen. 
size: 3
category: power
squareSprite: false


requirements: [
  efscrap/250
  efcopper/180
  efalluminum/120
]


consumes: {
  liquids: [
 	efozone/0.1
	efneutralizer/0.1
  ]
}


powerProduction: 5
ambientSound: loopSmelter
ambientSoundVolume: 0.03
hasLiquids: true
hasPower: true


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: efozone
      alpha: 1
      padding: 3
    } 
    {
      type: DrawDefault
    }
    {
	    type: DrawGlowRegion
	    alpha: 1
	    glowIntensity: 0.6
	    color: FF40BFFF
	    suffix: -glow
	    glowScale: 20
	  }
    {
      type: DrawRegion
      suffix: -top
    } 
  ]
}


research: {
	parent: efignition-plant
	objectives: [
		efozone, 
    {
      type: OnSector
      preset: pirc
		} 
	]
} 
researchCost: [
	efscrap/1250
	efcopper/900
	efalluminum/600
]
	
