type: GenericCrafter
name: Water Purifier
description: Purifies Contaminated Water, in the process siphoning out little amounts of resources.
size: 3


hasLiquids: true
hasPower: true
squareSprite: true
liquidCapacity: 60
hasItems: true
itemCapacity: 20
craftTime: 240


outputLiquid: efpurified-water/0.3
consumes: {
	liquids: [
  	  efdirty-water/0.4
 	  efneutralizer/0.1
	]
	power: 2
}
outputItems: [
	efalluminum/3
]


category: crafting
ambientSound: water-purifier
ambientSoundVolume: 0.2


requirements: [
	efscrap/60
	efcopper/80
	efcupride/20
]


research: {
	parent: efcupride-chamber
	objectives: [
	  efcupride
	] 
} 
researchCost: [
	efscrap/600
    efcopper/800
    efalluminum/200
]


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidTile
      drawLiquid: efdirty-water
      alpha: 1
      padding: 3
    }
    {
      type: DrawLiquidRegion
      suffix: -liquid
      drawLiquid: efpurified-water
      alpha: 1
      padding: 3
    } 
    {
      type: DrawBubbles
      fill: false
      color: 00AAFFFF
	}
    {
      type: DrawBubbles
      fill: false
      color: 007FBFFF
    }
    {
      type: DrawPistons
	  suffix: -piston
	  sinMag: 4
	  sinScale: 10
	  sides: 4
	  angleOffset: 225
	}
    {
	  type: DrawCrucibleFlame
	  flameColor: 127DB2FF
	}  
    {
      type: DrawDefault
    } 
  ]
}
