type: GenericCrafter
name: Chemical Chamber
description: Uses Nitrogen and flammable materials like soft coal and lpg to reduce them to smaller bonds and then molding them into Polycarbonate.
size: 3


hasLiquids: true
squareSprite: false
liquidCapacity: 15
hasItems: true
hasPower: true
itemCapacity: 10
craftTime: 120


consumes: {
	power: 3
	liquids: [
  	  eflpg/0.01666666666666666
      efneutralizer/0.1
	]
	items: [
	  efsoft-coal/1
	]
}


outputItems: [
  efpolycarbonate/1
]


category: crafting
ambientSound: chemical-chamber
ambientSoundVolume: 0.12


