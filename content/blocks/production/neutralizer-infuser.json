type: GenericCrafter
name: Neutralizer Infuser
description: Cools down Slag via low pressure, then mixes it with Contaminated Water, in the process infusing the Slag with its components and creating the Neutralizer.
category: crafting
size: 3


hasLiquids: true
hasItems: true
squareSprite: false
hasPower: true


liquidCapacity: 180
itemCapacity: 30


outputLiquids: [
    efneutralizer/0.6
]


consumes: {
    power: 0.25
	liquids: [
        efslag/0.15
        efdirty-water/0.05
    ]
}
craftTime: 30


ambientSound: loopSteam
ambientSoundVolume: 0.08


requirements: [
  efscrap/45
  efcopper/25
]


drawer: {
  type: DrawMulti
  drawers: [
    {
      type: DrawRegion
      suffix: -bottom
    }
    {
      type: DrawLiquidRegion
	  suffix: -liquid1
      drawLiquid: efslag
      alpha: 1
      padding: 3
	}
    {
      type: DrawLiquidRegion
	  suffix: -liquid2
      drawLiquid: efdirty-water
      alpha: 1
      padding: 3
	} 
    {
      type: DrawLiquidRegion
	  suffix: -liquid3
      drawLiquid: efneutralizer
      alpha: 1
      padding: 3
    }
    {
    type: DrawCrucibleFlame
    flameColor: 80EAFFFF
	particleRad: 2.5
	particleLife: 240
	fadeMargin: 1
